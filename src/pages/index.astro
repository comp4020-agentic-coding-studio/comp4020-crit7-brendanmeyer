---
// The landing page has no login: it's a tile per seeded person, exactly the
// way HORUS's own PeopleSoft homepage is a tile per app, and identity travels
// in the URL from here on (/ess/[personId] or /mss/[personId]).
import Base from "../layouts/Base.astro";
import { isManager, listPeople } from "../lib/db";

const people = listPeople();

function initials(name: string): string {
  return name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .toUpperCase();
}
---

<Base title="Absence Management">
  <h1>Absence Management</h1>
  <p>Pick a person to sign in as. This prototype has no passwords.</p>
  <div class="tile-grid">
    {
      people.map((person) => (
        <a class="tile" href={isManager(person) ? `/mss/${person.id}` : `/ess/${person.id}`}>
          <span class="avatar" aria-hidden="true">
            {initials(person.name)}
          </span>
          <span class="list-row-title">{person.name}</span>
          <span class="role-badge">{isManager(person) ? "Manager" : "Employee"}</span>
        </a>
      ))
    }
  </div>
</Base>
