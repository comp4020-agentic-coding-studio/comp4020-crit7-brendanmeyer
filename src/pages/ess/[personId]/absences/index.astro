---
import Base from "../../../../layouts/Base.astro";
import { errorMessage } from "../../../../lib/error-messages";
import {
  getPerson,
  getRequestById,
  isManager,
  listBalances,
  listLeaveTypes,
  listRequestsForPerson,
  planLeaveSubmission,
} from "../../../../lib/db";

const personId = Number(Astro.params.personId);
const person = getPerson(personId);
if (!person) return Astro.redirect("/", 302);
if (isManager(person)) return Astro.redirect(`/mss/${person.id}`, 302);

const balances = listBalances(person.id);
const leaveTypes = listLeaveTypes();
const requests = listRequestsForPerson(person.id);
const error = errorMessage(Astro.url.searchParams.get("error") ?? undefined);

// On a failed submit the API route redirects back with the submitted
// values on the query string, so a rejected request doesn't reset the form
// the user just filled in.
const params = Astro.url.searchParams;
const formValues = {
  leaveTypeId: params.get("leaveTypeId") ?? "",
  startDate: params.get("startDate") ?? "",
  endDate: params.get("endDate") ?? "",
  hoursFirstDay: params.get("hoursFirstDay") || "7",
  hoursLastDay: params.get("hoursLastDay") || "7",
  reason: params.get("reason") ?? "",
};

// planLeaveSubmission (src/lib/db.ts) flagged an overlap with an existing
// request and redirected back here instead of writing anything — the
// employee has to explicitly confirm what happens next. Re-derive the plan
// fresh from the echoed original fields rather than trusting anything
// computed at redirect time (same principle submit-confirm.ts uses before
// writing) — an overlap can now split into any number of segments, so
// there's no fixed set of "adjusted*" fields to encode in the query string.
const confirm = params.get("confirm");
const confirmPlan =
  confirm && formValues.startDate && formValues.endDate
    ? planLeaveSubmission({
        personId: person.id,
        leaveTypeId: Number(formValues.leaveTypeId),
        startDate: formValues.startDate,
        endDate: formValues.endDate,
        hoursFirstDay: Number(formValues.hoursFirstDay),
        hoursLastDay: Number(formValues.hoursLastDay),
      })
    : undefined;
const overlapRequest =
  confirmPlan && "overlapRequestId" in confirmPlan ? getRequestById(confirmPlan.overlapRequestId) : undefined;

function describeSegments(segments: { startDate: string; endDate: string; hoursRequested: number }[]): string {
  if (segments.length === 1) {
    const s = segments[0];
    return `${s.hoursRequested} hour(s), ${s.startDate} to ${s.endDate}`;
  }
  return (
    `${segments.length} separate requests — ` +
    segments.map((s) => `${s.hoursRequested}h (${s.startDate} to ${s.endDate})`).join(", ")
  );
}

function statusLabel(status: string): string {
  switch (status) {
    case "submitted":
      return "Submitted";
    case "approved":
      return "Approved";
    case "denied":
      return "Denied";
    case "cancel_requested":
      return "Cancel in Progress";
    case "cancelled":
      return "Cancelled";
    default:
      return status;
  }
}
---

<Base title="Manage Absences">
  <h1>Manage Absences</h1>
  <p class="hint">{person.name} · Employee Self Service</p>

  {error && <p class="banner banner-error">{error}</p>}

  {
    overlapRequest && confirmPlan?.kind === "overlap" && (
      <form class="card" method="post" action="/api/leave/submit-confirm">
        <input type="hidden" name="personId" value={person.id} />
        {(["leaveTypeId", "startDate", "endDate", "hoursFirstDay", "hoursLastDay", "reason"] as const).map((key) => (
          <input type="hidden" name={key} value={formValues[key]} />
        ))}
        <p class="banner banner-warning">
          This overlaps your {overlapRequest.leaveType.name} request from {overlapRequest.startDate} to{" "}
          {overlapRequest.endDate}
          {confirmPlan.overlapCount > 1 && ` (and ${confirmPlan.overlapCount - 1} more)`}. To avoid double-counting
          those days, this would be submitted as <strong>{describeSegments(confirmPlan.segments)}</strong>.
        </p>
        <div class="inline-actions">
          <button type="submit" name="action" value="trim">
            {confirmPlan.segments.length > 1 ? "Submit adjusted requests" : "Submit adjusted request"}
          </button>
          <button type="submit" name="action" value="as_entered" class="secondary">
            Submit full amount anyway
          </button>
        </div>
      </form>
    )
  }

  {
    overlapRequest && confirmPlan?.kind === "medical_replace_candidate" && (
      <form class="card" method="post" action="/api/leave/submit-confirm">
        <input type="hidden" name="personId" value={person.id} />
        {(["leaveTypeId", "startDate", "endDate", "hoursFirstDay", "hoursLastDay", "reason"] as const).map((key) => (
          <input type="hidden" name={key} value={formValues[key]} />
        ))}
        <p class="banner banner-warning">
          This overlaps your Annual Leave request from {overlapRequest.startDate} to {overlapRequest.endDate}. You
          can replace those overlapping days with Medical Leave instead — the Annual Leave request will shrink or
          be cancelled, and its balance restored, once a manager approves this Medical Leave request.
          {confirmPlan.segments &&
            ` Or, if you only want to cover the days not already on leave, just request ${describeSegments(confirmPlan.segments)} as Medical Leave and leave the Annual Leave request untouched.`}
        </p>
        <div class="inline-actions">
          <button type="submit" name="action" value="replace">
            Replace those days with Medical Leave
          </button>
          {confirmPlan.segments && (
            <button type="submit" name="action" value="trim" class="secondary">
              {confirmPlan.segments.length > 1 ? "Submit only the extra days" : "Submit only the extra hours"}
            </button>
          )}
          <button type="submit" name="action" value="as_entered" class="secondary">
            Submit full amount anyway
          </button>
        </div>
      </form>
    )
  }

  <div class="balance-grid">
    {
      balances.map((balance) => (
        <div class="balance-tile">
          <div class="balance-days">{balance.balanceHours.toFixed(1)}</div>
          <div class="balance-label">{balance.leaveType.name} (hours)</div>
        </div>
      ))
    }
  </div>

  <form class="card" method="post" action="/api/leave/submit" id="apply-leave-form">
    <input type="hidden" name="personId" value={person.id} />
    <h2>Apply for Leave</h2>
    <div class="field">
      <label for="leaveTypeId">Leave type</label>
      <select id="leaveTypeId" name="leaveTypeId" required>
        {
          leaveTypes.map((leaveType) => (
            <option value={leaveType.id} selected={String(leaveType.id) === formValues.leaveTypeId}>
              {leaveType.name}
            </option>
          ))
        }
      </select>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="startDate">Start date</label>
        <input id="startDate" name="startDate" type="date" required value={formValues.startDate} />
      </div>
      <div class="field">
        <label for="endDate">End date</label>
        <input id="endDate" name="endDate" type="date" required value={formValues.endDate} />
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="hoursFirstDay" id="hoursFirstDayLabel">Hours on first day</label>
        <input
          id="hoursFirstDay"
          name="hoursFirstDay"
          type="number"
          min="0.5"
          max="7"
          step="0.5"
          value={formValues.hoursFirstDay}
          required
        />
      </div>
      <div class="field" id="hoursLastDayField">
        <label for="hoursLastDay">Hours on last day</label>
        <input
          id="hoursLastDay"
          name="hoursLastDay"
          type="number"
          min="0.5"
          max="7"
          step="0.5"
          value={formValues.hoursLastDay}
          required
        />
      </div>
    </div>
    <p class="hint">A full work day is 7 hours. Weekends never count towards a request.</p>
    <p class="hours-preview" id="hours-preview" aria-live="polite"></p>
    <p class="banner banner-warning" id="overlap-preview" aria-live="polite"></p>
    <div class="field">
      <label for="reason">Reason (optional)</label>
      <textarea id="reason" name="reason" rows="2">{formValues.reason}</textarea>
    </div>
    <div class="field">
      <label for="attachment">Supporting document (optional)</label>
      <input id="attachment" name="attachment" type="file" disabled />
      <p class="hint">Attachments aren't stored in this prototype.</p>
    </div>
    <button type="submit">Submit request</button>
  </form>

  <h2>Your Requests</h2>
  {requests.length === 0 && <p class="empty-state">No leave requests yet.</p>}
  {
    requests.map((request) => (
      <div class="list-row">
        <div class="list-row-main">
          <div class="list-row-title">{request.leaveType.name}</div>
          <div class="list-row-meta">
            {request.startDate} to {request.endDate} · {request.hoursRequested.toFixed(1)} hours
          </div>
          {request.reason && <div class="list-row-meta">Reason: {request.reason}</div>}
          {request.systemNote && <p class="banner banner-info">{request.systemNote}</p>}
        </div>
        <span class={`status-pill status-${request.status}`}>{statusLabel(request.status)}</span>
      </div>
    ))
  }

  <p><a href={`/ess/${person.id}/absences/cancel`}>Cancel an absence</a></p>
</Base>

<script>
  // Live readout as the user fills in the form: how many hours it counts
  // (unchanged), plus — proactively, before they ever click Submit — a
  // heads-up if it overlaps their own existing leave. Both come from
  // /api/leave/preview, which wraps src/lib/leave-hours.ts and
  // planLeaveSubmission (src/lib/db.ts); this script only fetches and
  // renders the result; the actual submit still re-checks server-side
  // regardless, so this is an early warning, not the safety net.
  import { ERROR_MESSAGES } from "../../../../lib/error-messages";

  const form = document.querySelector<HTMLFormElement>("#apply-leave-form");
  const hoursPreview = document.querySelector<HTMLParagraphElement>("#hours-preview");
  const overlapPreview = document.querySelector<HTMLParagraphElement>("#overlap-preview");
  const hoursLastDayField = document.querySelector<HTMLElement>("#hoursLastDayField");
  const hoursFirstDayLabel = document.querySelector<HTMLLabelElement>("#hoursFirstDayLabel");

  if (form && hoursPreview && overlapPreview && hoursLastDayField && hoursFirstDayLabel) {
    const personId = form.elements.namedItem("personId") as HTMLInputElement;
    const leaveTypeId = form.elements.namedItem("leaveTypeId") as HTMLSelectElement;
    const startDate = form.elements.namedItem("startDate") as HTMLInputElement;
    const endDate = form.elements.namedItem("endDate") as HTMLInputElement;
    const hoursFirstDay = form.elements.namedItem("hoursFirstDay") as HTMLInputElement;
    const hoursLastDay = form.elements.namedItem("hoursLastDay") as HTMLInputElement;
    const fields = [leaveTypeId, startDate, endDate, hoursFirstDay, hoursLastDay];

    // A single-day request only ever uses hoursFirstDay (see
    // computeHoursRequested), so showing a second selector for the same day
    // is just confusing — hide it and keep it mirroring the first value.
    const syncSingleDay = () => {
      const singleDay = startDate.value !== "" && startDate.value === endDate.value;
      hoursLastDayField.hidden = singleDay;
      hoursFirstDayLabel.textContent = singleDay ? "Hours" : "Hours on first day";
      if (singleDay) hoursLastDay.value = hoursFirstDay.value;
    };
    startDate.addEventListener("input", syncSingleDay);
    endDate.addEventListener("input", syncSingleDay);
    hoursFirstDay.addEventListener("input", syncSingleDay);
    syncSingleDay();

    const update = async () => {
      if (!startDate.value || !endDate.value || !hoursFirstDay.value || !hoursLastDay.value) {
        hoursPreview.textContent = "";
        overlapPreview.textContent = "";
        return;
      }
      const query = new URLSearchParams({
        startDate: startDate.value,
        endDate: endDate.value,
        hoursFirstDay: hoursFirstDay.value,
        hoursLastDay: hoursLastDay.value,
        personId: personId.value,
        leaveTypeId: leaveTypeId.value,
      });
      const res = await fetch(`/api/leave/preview?${query}`);
      const result = await res.json();

      if (!result.ok) {
        hoursPreview.textContent = ERROR_MESSAGES[result.error] ?? "";
        overlapPreview.textContent = "";
        return;
      }
      const dayWord = result.businessDays.length === 1 ? "business day" : "business days";
      hoursPreview.innerHTML =
        `<strong>${result.hoursRequested} hour(s)</strong> across ${result.businessDays.length} ` +
        `${dayWord} will count towards your balance.`;

      const describeSegments = (segments: { startDate: string; endDate: string; hoursRequested: number }[]) =>
        segments.length === 1
          ? `${segments[0].hoursRequested}h (${segments[0].startDate} to ${segments[0].endDate})`
          : `${segments.length} separate requests (` +
            segments.map((s) => `${s.hoursRequested}h ${s.startDate} to ${s.endDate}`).join(", ") +
            `)`;

      const overlap = result.overlap;
      if (!overlap) {
        overlapPreview.textContent = "";
      } else if (overlap.kind === "invalid") {
        overlapPreview.textContent = ERROR_MESSAGES[overlap.error] ?? "";
      } else if (overlap.kind === "fully_covered") {
        overlapPreview.textContent = ERROR_MESSAGES.fully_covered_by_existing;
      } else if (overlap.kind === "medical_replace_candidate") {
        overlapPreview.textContent = overlap.segments
          ? `This overlaps an existing Annual Leave request — submitting will offer to replace those days with Medical Leave, or just add ${describeSegments(overlap.segments)}.`
          : "This overlaps an existing Annual Leave request — submitting will offer to replace those days with Medical Leave.";
      } else if (overlap.kind === "overlap") {
        overlapPreview.textContent =
          `This overlaps existing leave — submitting will offer to adjust this to ${describeSegments(overlap.segments)} ` +
          `instead of double-booking those days.`;
      }
    };

    for (const field of fields) field.addEventListener("input", update);
    update();
  }
</script>
